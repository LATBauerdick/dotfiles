{
  "title": "Window tiling on ctrl-option (LATB)",
  "rules": [
    {
      "description": "ctrl-option h/i/e/n halves, shift = arrange pair, f Fill, c Center, r Return -> macOS fn-ctrl tiling shortcuts",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "h",
            "modifiers": {
              "mandatory": [
                "control",
                "option",
                "shift"
              ],
              "optional": [
                "caps_lock"
              ]
            }
          },
          "to": [
            {
              "key_code": "left_arrow",
              "modifiers": [
                "fn",
                "control",
                "shift"
              ]
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "i",
            "modifiers": {
              "mandatory": [
                "control",
                "option",
                "shift"
              ],
              "optional": [
                "caps_lock"
              ]
            }
          },
          "to": [
            {
              "key_code": "right_arrow",
              "modifiers": [
                "fn",
                "control",
                "shift"
              ]
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "e",
            "modifiers": {
              "mandatory": [
                "control",
                "option",
                "shift"
              ],
              "optional": [
                "caps_lock"
              ]
            }
          },
          "to": [
