{
  "title": "Window tiling on ctrl-option (LATB)",
  "rules": [
    {
      "description": "Window tiling: ctrl-option h/i/e/n (+shift), f/c/r -> fn-ctrl tiling; keyboards sending Colemak letters (Planck), not the built-in",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "h",
            "modifiers": {
              "mandatory": [
                "control",
                "option",
                "shift"
              ],
              "optional": [
                "caps_lock"
              ]
            }
          },
          "to": [
            {
              "key_code": "left_arrow",
              "modifiers": [
                "fn",
                "control",
                "shift"
              ]
            }
          ],
          "conditions": [
            {
              "type": "device_unless",
              "identifiers": [
                {
                  "is_built_in_keyboard": true
                }
              ]
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "i",
            "modifiers": {
              "mandatory": [
                "control",
                "option",
                "shift"
              ],
              "optional": [
                "caps_lock"
              ]
            }
          },
          "to": [
            {
              "key_code": "right_arrow",
              "modifiers": [
                "fn",
                "control",
                "shift"
              ]
            }
