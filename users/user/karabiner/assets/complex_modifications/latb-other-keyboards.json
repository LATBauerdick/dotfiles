{
  "title": "LATB: all other keyboards (QMK, mechanical) - Colemak in firmware, not remapped",
  "rules": [
    {
      "description": "[Other kbd: QMK, mechanical] Window tiling: ctrl-option h/i/e/n (+shift), f/c/r -> fn-ctrl tiling",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "h",
            "modifiers": {
              "mandatory": [
                "control",
                "option",
                "shift"
              ],
              "optional": [
                "caps_lock"
              ]
            }
          },
          "to": [
            {
              "key_code": "left_arrow",
              "modifiers": [
                "fn",
                "control",
                "shift"
              ]
            }
          ],
          "conditions": [
            {
              "type": "device_unless",
              "identifiers": [
                {
                  "is_built_in_keyboard": true
                },
                {
                  "vendor_id": 1452
                },
                {
                  "vendor_id": 76
                }
              ]
            }
          ]
        },
        {
          "type": "basic",
