# BEGIN ALGO MANAGED BLOCK 162.243.79.69
# The GSSAPI lines below need an OpenSSH built with Kerberos; the NixOS hosts
# get one via programs.ssh.package = openssh_gssapi (users/latb/latb.nix).
# UseKeychain yes
AddKeysToAgent yes

# Own NixOS hosts: forward the agent so git on them can reach GitHub with the
# (passphrase-protected) key held by the machine you connect from (2026-09-18).
Host upro umac ude fmini
  ForwardAgent yes

Host wde
HostName 116.203.126.183
  User latb
  LocalForward   *:8389  127.0.0.1:8384
  LocalForward   *:8089  127.0.0.1:8080

Host lpi
# 192.168.0.193 eth, 192.168.0.106 wlan, 10.55.0.1 usb
  Hostname lpi.local
  User bauerdic

Host gitlab.com
  Preferredauthentications publickey
  IdentityFile ~/.ssh/id_rsa

Host gitlab.cern.ch
  Preferredauthentications publickey
  IdentityFile ~/.ssh/id_rsa

# Fermilab machines: account is bauerdic (same uid 6170, different name);
# everything else defaults to latb (Host *). The Fermilab Macs appear on the
# tailnet as mac-<property number>[-n] (mac-147779, mac-149207, mac-132644).
Host mac-1*
    User bauerdic

# nicknames for the two FNAL Macs (tailnet names stay mac-<property number>)
Host fair
    HostName mac-149207
    User bauerdic
Host ftop
    HostName mac-147779
    User bauerdic

Host cmslpc*.fnal.gov
    User bauerdic
    GSSAPIAuthentication yes
    GSSAPIDelegateCredentials yes
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null

Host 131.225.* *.fnal.gov
    User bauerdic
    GSSAPIAuthentication yes
    GSSAPIDelegateCredentials yes
#    StrictHostKeyChecking no
    ForwardX11Trusted yes
    ForwardX11 yes

Host *
  User latb
  Port 22
  IdentityFile   ~/.ssh/id_ed25519
